diff --git a/src/input/decoder.c b/src/input/decoder.c
index 69488a6..850f8f8 100644
--- a/src/input/decoder.c
+++ b/src/input/decoder.c
@@ -77,6 +77,7 @@ struct decoder_owner_sys_t
 
     sout_instance_t         *p_sout;
     sout_packetizer_input_t *p_sout_input;
+    bool                     b_sout_stream_time; /* "sout-stream-time": no clock conversion */
 
     vlc_thread_t     thread;
 
@@ -846,8 +847,9 @@ static int DecoderPlaySout( decoder_t *p_dec, block_t *p_sout_block )
     }
 
     DecoderWaitUnblock( p_dec );
-    DecoderFixTs( p_dec, &p_sout_block->i_dts, &p_sout_block->i_pts,
-                  &p_sout_block->i_length, NULL, INT64_MAX );
+    if( !p_owner->b_sout_stream_time )
+        DecoderFixTs( p_dec, &p_sout_block->i_dts, &p_sout_block->i_pts,
+                      &p_sout_block->i_length, NULL, INT64_MAX );
 
     vlc_mutex_unlock( &p_owner->lock );
 
@@ -1685,6 +1687,7 @@ static decoder_t * CreateDecoder( vlc_object_t *p_parent,
     p_owner->i_spu_order = 0;
     p_owner->p_sout = p_sout;
     p_owner->p_sout_input = NULL;
+    p_owner->b_sout_stream_time = p_sout != NULL && var_InheritBool( p_dec, "sout-stream-time" );
     p_owner->p_packetizer = NULL;
 
     p_owner->b_fmt_description = false;
