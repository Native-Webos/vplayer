diff --git a/contrib/src/gcrypt/rules.mak b/contrib/src/gcrypt/rules.mak
index c89be90..3bc45cd 100644
--- a/contrib/src/gcrypt/rules.mak
+++ b/contrib/src/gcrypt/rules.mak
@@ -22,6 +22,10 @@ gcrypt: libgcrypt-$(GCRYPT_VERSION).tar.bz2 .sum-gcrypt
 
 	# don't use getpid in UWP as it's not actually available
 	$(APPLY) $(SRC)/gcrypt/gcrypt-uwp-getpid.patch
+	# webOS apps run in a jail with /dev/urandom but no /dev/random: libgcrypt then finds no
+	# entropy source and exit()s the process at its first random number (an SFTP connection).
+	# Read /dev/urandom for both (the Linux advice once the system is up).
+	sed -i -e 's,^NAME_OF_DEV_RANDOM="/dev/random",NAME_OF_DEV_RANDOM="/dev/urandom",' $(UNPACK_DIR)/configure.ac
 
 ifdef HAVE_ANDROID
 	# disable ARM code that doesn't compile on Android
