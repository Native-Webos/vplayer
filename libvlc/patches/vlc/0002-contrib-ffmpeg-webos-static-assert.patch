@@ -107,6 +107,10 @@ endif
 # Linux
 ifdef HAVE_LINUX
 POSTPROC_CONF += --target-os=linux --enable-pic
+ifeq ($(HOST),arm-webos-linux-gnueabi)
+# webOS sysroot is glibc 2.12, whose <assert.h> predates the C11 static_assert macro (glibc 2.16).
+POSTPROC_CONF += --extra-cflags=-Dstatic_assert=_Static_assert
