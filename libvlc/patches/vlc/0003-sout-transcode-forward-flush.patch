+/* A seek or a stream change upstream: drop what the decoder holds and pass the flush on, so the
+ * next stream output knows where the new data starts (VLC 3 does not, VLC 4 does). */
+static void Flush( sout_stream_t *p_stream, sout_stream_id_sys_t *id )
+{
+    if( id->b_transcode && id->p_decoder->pf_flush )
+        id->p_decoder->pf_flush( id->p_decoder );
+    if( id->id )
+        sout_StreamFlush( p_stream->p_next, id->id );
+}
