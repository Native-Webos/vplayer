diff --git a/contrib/src/openssl/rules.mak b/contrib/src/openssl/rules.mak
new file mode 100644
index 0000000..ac1853f
--- /dev/null
+++ b/contrib/src/openssl/rules.mak
@@ -0,0 +1,34 @@
+# openssl: libcrypto, for libssh2's crypto backend (the libgcrypt one has neither the key exchanges
+# nor the host key signatures current OpenSSH servers accept).
+
+OPENSSL_VERSION := 3.5.9
+OPENSSL_URL := https://github.com/openssl/openssl/releases/download/openssl-$(OPENSSL_VERSION)/openssl-$(OPENSSL_VERSION).tar.gz
+
+$(TARBALLS)/openssl-$(OPENSSL_VERSION).tar.gz:
+	$(call download_pkg,$(OPENSSL_URL),openssl)
+
+.sum-openssl: openssl-$(OPENSSL_VERSION).tar.gz
+
+openssl: openssl-$(OPENSSL_VERSION).tar.gz .sum-openssl
+	$(UNPACK)
+	$(MOVE)
+
+ifeq ($(ARCH),arm)
+OPENSSL_TARGET := linux-armv4
+else ifeq ($(ARCH),aarch64)
+OPENSSL_TARGET := linux-aarch64
+else ifeq ($(ARCH),x86_64)
+OPENSSL_TARGET := linux-x86_64
+else
+OPENSSL_TARGET := linux-generic32
+endif
+
+.openssl: openssl
+	cd $< && $(HOSTVARS) ./Configure $(OPENSSL_TARGET) no-shared no-tests no-docs no-engine no-dso no-module \
+		-fPIC --prefix=$(PREFIX) --libdir=lib
+	+cd $< && $(MAKE) build_libs
+	+cd $< && $(MAKE) install_dev
+	# Static: what libcrypto needs goes with it (the plugins link with the plain pkg-config flags;
+	# glibc 2.12 keeps the threads in libpthread).
+	sed -i -e 's,^Libs: -L$${libdir} -lcrypto$$,Libs: -L$${libdir} -lcrypto -ldl -lpthread -latomic,' $(PREFIX)/lib/pkgconfig/libcrypto.pc
+	touch $@
